#!/bin/bash
#PBS -N hep-sig-kin
#PBS -q workq
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -m n
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
.venv-preprocess/bin/python -u -B scripts/validation/signal_kinematics.py --out data/results/signal_kinematics_20261003.json
