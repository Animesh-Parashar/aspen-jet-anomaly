#!/bin/bash
#PBS -N hep-ref-support
#PBS -q workq
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m n
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1
.venv-preprocess/bin/python -u -B scripts/validation/transfer_diagnostics.py support --out data/results/transfer_support_20261003.json
